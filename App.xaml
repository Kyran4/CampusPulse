<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="CampusPulse.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:CampusPulse.Helpers">

    <Application.Resources>

        <helpers:InvertedBoolConverter x:Key="InvertedBoolConverter" />

        <!-- ========================= -->
        <!--        COLOR PALETTE      -->
        <!-- ========================= -->
        <Color x:Key="PrimaryColor">#3B82F6</Color>
        <Color x:Key="SecondaryColor">#1E293B</Color>
        <Color x:Key="AccentColor">#10B981</Color>
        <Color x:Key="LightGray">#F3F4F6</Color>
        <Color x:Key="DarkGray">#6B7280</Color>
        <Color x:Key="CardBackground">#FFFFFF</Color>

        <!-- ========================= -->
        <!--        TEXT STYLES        -->
        <!-- ========================= -->
        <Style TargetType="Label" x:Key="TitleLabel">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="White" />
        </Style>

        <Style TargetType="Label" x:Key="SectionHeader">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource SecondaryColor}" />
            <Setter Property="Margin" Value="0,20,0,10" />
        </Style>

        <Style TargetType="Label" x:Key="BodyLabel">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="{StaticResource SecondaryColor}" />
        </Style>

        <!-- ========================= -->
        <!--        BUTTON STYLE       -->
        <!-- ========================= -->
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="15,10" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <!-- ========================= -->
        <!--        CARD STYLE         -->
        <!-- ========================= -->
        <Style TargetType="Frame" x:Key="Card">
            <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="15" />
            <Setter Property="Margin" Value="0,10" />
            <Setter Property="HasShadow" Value="True" />
        </Style>

        <!-- ========================= -->
        <!--        ENTRY STYLE        -->
        <!-- ========================= -->
        <Style TargetType="Entry" x:Key="InputField">
            <Setter Property="BackgroundColor" Value="{StaticResource LightGray}" />
            <Setter Property="TextColor" Value="{StaticResource SecondaryColor}" />
            <Setter Property="Margin" Value="0,10" />
            <Setter Property="HeightRequest" Value="45" />
        </Style>


    </Application.Resources>
</Application>
