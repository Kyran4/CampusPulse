<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CampusPulse.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CampusPulse.Views"
    FlyoutBehavior="Disabled">

    <!-- No more hamburger/flyout menu - FlyoutBehavior="Disabled" above
         removes that affordance entirely, regardless of how many top-level
         items exist below. All navigation between Login/Register and the
         main app happens through code (GoToAsync), same as before - this
         setting only changes how it's presented, not how it's reached. -->

    <!-- Pre-auth screens - shown full-screen, no bottom tabs, until the
         Navigating guard (see AppShell.xaml.cs) lets you past them. -->
    <ShellContent Route="LoginPage" ContentTemplate="{DataTemplate views:LoginPage}" />
    <ShellContent Route="RegisterPage" ContentTemplate="{DataTemplate views:RegisterPage}" />

    <!-- Main app - Instagram-style bottom tab bar. This replaces the old
         flyout list of FeedPage/EventsPage/MyPostsPage/ProfilePage entries.
         "Admin" is added/removed from this TabBar's Items at runtime (see
         AddAdminTab/RemoveAdminTab in the code-behind) rather than being
         declared here, since it should only ever appear for Admins. -->
    <TabBar x:Name="MainTabBar" Route="MainTabs">

        <Tab Title="Feed" Icon="feed.png" Route="FeedPage">
            <ShellContent Route="FeedPage" ContentTemplate="{DataTemplate views:FeedPage}" />
        </Tab>

        <Tab Title="Events" Icon="events.png" Route="EventsPage">
            <ShellContent Route="EventsPage" ContentTemplate="{DataTemplate views:EventsPage}" />
        </Tab>

        <Tab Title="Create" Icon="create.png" Route="CreatePostPage">
            <ShellContent Route="CreatePostPage" ContentTemplate="{DataTemplate views:CreatePostPage}" />
        </Tab>

        <Tab Title="My Posts" Icon="posts.png" Route="MyPostsPage">
            <ShellContent Route="MyPostsPage" ContentTemplate="{DataTemplate views:MyPostsPage}" />
        </Tab>

        <Tab Title="Profile" Icon="profile.png" Route="ProfilePage">
            <ShellContent Route="ProfilePage" ContentTemplate="{DataTemplate views:ProfilePage}" />
        </Tab>

    </TabBar>

</Shell>
