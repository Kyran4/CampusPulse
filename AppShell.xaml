<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CampusPulse.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CampusPulse"
    xmlns:views="clr-namespace:CampusPulse.Views"
    Title="CampusPulse">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Interests"
        ContentTemplate="{DataTemplate views:InterestsPage}"
        Route="InterestsPage" />

</Shell>