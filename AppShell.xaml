<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CampusPulse.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CampusPulse"
    xmlns:views="clr-namespace:CampusPulse.Views"
    Title="CampusPulse">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Feed"
        ContentTemplate="{DataTemplate views:FeedPage}"
        Route="FeedPage" />

    <ShellContent
        Title="Interests"
        ContentTemplate="{DataTemplate views:InterestsPage}"
        Route="InterestsPage" />

    <ShellContent
        Title="Events"
        ContentTemplate="{DataTemplate views:EventsPage}"
        Route="EventsPage" />

    <ShellContent
        Title="CreatePost"
        ContentTemplate="{DataTemplate views:CreatePostPage}"
        Route="CreatePostPage" />

    <ShellContent
        Title="MyPosts"
        ContentTemplate="{DataTemplate views:MyPostsPage}"
        Route="MyPostsPage" />

    <ShellContent
        Title="Profile"
        ContentTemplate="{DataTemplate views:ProfilePage}"
        Route="ProfilePage" />

    <ShellContent
        Title="Reports"
        ContentTemplate="{DataTemplate views:ReportsPage}"
        Route="ReportsPage" />

    <ShellContent
        Title="About"
        ContentTemplate="{DataTemplate views:AboutPage}"
        Route="AboutPage" />

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <ShellContent
        Title="Register"
        ContentTemplate="{DataTemplate views:RegisterPage}"
        Route="RegisterPage" />

    <ShellContent
        Title="Admin Dashboard"
        ContentTemplate="{DataTemplate views:AdminDashboardPage}"
        Route="AdminDashboardPage" />

    <ShellContent
        Title="Admin Moderation"
        ContentTemplate="{DataTemplate views:AdminModerationPage}"
        Route="AdminModerationPage" />

    <ShellContent
        Title="Event Details"
        ContentTemplate="{DataTemplate views:EventDetailsPage}"
        Route="EventDetailsPage" />

    <ShellContent
        Title="Post Details"
        ContentTemplate="{DataTemplate views:PostDetailsPage}"
        Route="PostDetailsPage" />

</Shell>