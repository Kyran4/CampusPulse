<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="CampusPulse.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CampusPulse.Views">

    <!-- Flyout Menu -->
    <FlyoutItem Title="Feed" Icon="feed.png" Route="FeedPage">
        <ShellContent Route="FeedPage" ContentTemplate="{DataTemplate views:FeedPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Events" Icon="events.png" Route="EventsPage">
        <ShellContent Route="EventsPage" ContentTemplate="{DataTemplate views:EventsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="My Posts" Icon="posts.png" Route="MyPostsPage" Shell.FlyoutItemIsVisible="False">
        <ShellContent Route="MyPostsPage" ContentTemplate="{DataTemplate views:MyPostsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Profile" Icon="profile.png" Route="ProfilePage">
        <ShellContent Route="ProfilePage" ContentTemplate="{DataTemplate views:ProfilePage}" />
    </FlyoutItem>

    <FlyoutItem Title="My Interests" Route="InterestsPage" Shell.FlyoutItemIsVisible="False">
        <ShellContent Route="InterestsPage" ContentTemplate="{DataTemplate views:InterestsPage}" />
    </FlyoutItem>

    <!-- Standalone Routes - FlyoutItemIsVisible="False" keeps these out of
         the flyout menu entirely. Without it, Shell auto-wraps every
         top-level ShellContent into its own visible, tappable flyout entry -
         which is why Login/Register (and these others) were showing up and
         staying clickable regardless of the runtime show/hide logic in
         AppShell.xaml.cs. These pages are only ever reached via GoToAsync. -->
    <ShellContent Route="CreatePostPage" Shell.FlyoutItemIsVisible="False" ContentTemplate="{DataTemplate views:CreatePostPage}" />
    <ShellContent Route="EventDetailsPage" Shell.FlyoutItemIsVisible="False" ContentTemplate="{DataTemplate views:EventDetailsPage}" />
    <ShellContent Route="PostDetailsPage" Shell.FlyoutItemIsVisible="False" ContentTemplate="{DataTemplate views:PostDetailsPage}" />
    <ShellContent Route="RegisterPage" Shell.FlyoutItemIsVisible="False" ContentTemplate="{DataTemplate views:RegisterPage}" />
    <ShellContent Route="LoginPage" Shell.FlyoutItemIsVisible="False" ContentTemplate="{DataTemplate views:LoginPage}" />
    <ShellContent Route="CreateEventPage" Shell.FlyoutItemIsVisible="False" ContentTemplate="{DataTemplate views:CreateEventPage}" />

</Shell>