<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="CampusPulse.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Home">

    <ScrollView>

        <VerticalStackLayout
            Padding="25"
            Spacing="20">

            <Label
                Text="CampusPulse"
                FontSize="32"
                FontAttributes="Bold" />

            <Label
                Text="Stay connected with what's happening around campus."
                FontSize="16"
                TextColor="Gray" />

            <Border
                Padding="20"
                Stroke="#DDDDDD"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Campus Feed"
                        FontSize="20"
                        FontAttributes="Bold" />

                    <Label
                        Text="View posts and updates from around campus."
                        TextColor="Gray" />

                </VerticalStackLayout>

            </Border>

            <Border
                Padding="20"
                Stroke="#DDDDDD"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Events"
                        FontSize="20"
                        FontAttributes="Bold" />

                    <Label
                        Text="See upcoming campus events and activities."
                        TextColor="Gray" />

                </VerticalStackLayout>

            </Border>

            <Border
                Padding="20"
                Stroke="#DDDDDD"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Your Interests"
                        FontSize="20"
                        FontAttributes="Bold" />

                    <Label
                        Text="Follow topics you are interested in to personalise your feed."
                        TextColor="Gray" />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>