<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Light Theme Colors -->
    <Color x:Key="LightBackground">#FFFFFF</Color>
    <Color x:Key="LightCard">#F5F5F5</Color>
    <Color x:Key="LightText">#222222</Color>
    <Color x:Key="LightAccent">#3B82F6</Color>

    <!-- Dark Theme Colors -->
    <Color x:Key="DarkBackground">#121212</Color>
    <Color x:Key="DarkCard">#1E1E1E</Color>
    <Color x:Key="DarkText">#E5E5E5</Color>
    <Color x:Key="DarkAccent">#60A5FA</Color>

</ResourceDictionary>
