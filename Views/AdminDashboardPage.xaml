<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CampusPulse.Views.AdminDashboardPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource LightGray}">

    <Grid RowDefinitions="Auto,Auto,*">

        <Grid BackgroundColor="{StaticResource PrimaryColor}" Padding="20">
            <Label Text="Admin Dashboard" Style="{StaticResource TitleLabel}" />
        </Grid>

        <!-- Stats - Should priority Admin story: total users, active users,
             post count, event count, pending reports -->
        <Frame Grid.Row="1" Style="{StaticResource Card}" Margin="20,20,20,0">
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                <VerticalStackLayout Grid.Column="0" Grid.Row="0">
                    <Label Text="{Binding Stats.TotalUsers}" FontAttributes="Bold" FontSize="22" HorizontalOptions="Center" />
                    <Label Text="Total Users" Style="{StaticResource BodyLabel}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Grid.Row="0">
                    <Label Text="{Binding Stats.ActiveUsers}" FontAttributes="Bold" FontSize="22" HorizontalOptions="Center" />
                    <Label Text="Active Users" Style="{StaticResource BodyLabel}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Grid.Row="0">
                    <Label Text="{Binding Stats.PostCount}" FontAttributes="Bold" FontSize="22" HorizontalOptions="Center" />
                    <Label Text="Posts" Style="{StaticResource BodyLabel}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="0" Grid.Row="1">
                    <Label Text="{Binding Stats.EventCount}" FontAttributes="Bold" FontSize="22" HorizontalOptions="Center" />
                    <Label Text="Events" Style="{StaticResource BodyLabel}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Grid.Row="1">
                    <Label Text="{Binding Stats.PendingReports}" FontAttributes="Bold" FontSize="22" HorizontalOptions="Center" />
                    <Label Text="Pending Reports" Style="{StaticResource BodyLabel}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Frame>

        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Posts}"
            SelectionMode="None"
            Margin="20">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="10">

                            <Label Text="{Binding Title}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource SecondaryColor}" />

                            <Label Text="{Binding Content}"
                                   Style="{StaticResource BodyLabel}" />

                            <HorizontalStackLayout Spacing="10">

                                <Button
                                    Text="View"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding BindingContext.OpenPostCommand, Source={x:Reference RootPage}}"
                                    CommandParameter="{Binding .}" />

                                <Button
                                    Text="Hide"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding BindingContext.HidePostCommand, Source={x:Reference RootPage}}"
                                    CommandParameter="{Binding .}" />

                            </HorizontalStackLayout>

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>
