<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CampusPulse.Views.EventsPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource LightGray}">

    <Grid RowDefinitions="Auto,Auto,*">

        <Grid BackgroundColor="{StaticResource PrimaryColor}" Padding="20">
            <Label Text="Events" Style="{StaticResource TitleLabel}" />
        </Grid>

        <!-- Admin only -->
        <Grid Grid.Row="1" Padding="20,10" IsVisible="{Binding IsAdmin}">
            <Button Text="Create Event"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding CreateEventCommand}" />
        </Grid>

        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Events}"
            SelectionMode="None"
            Margin="20">

            <CollectionView.EmptyView>
                <Label Text="No events scheduled yet."
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{StaticResource SecondaryColor}" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="10">

                            <Image Source="{Binding ImageBase64, Converter={StaticResource ImageConverter}}"
                                   Aspect="AspectFill"
                                   HeightRequest="160"
                                   IsVisible="{Binding ImageBase64, Converter={StaticResource HasImageConverter}}" />

                            <Label Text="{Binding Title}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource SecondaryColor}" />

                            <Label Text="{Binding Description}"
                                   Style="{StaticResource BodyLabel}" />

                            <Label Text="Cancelled"
                                   TextColor="Red"
                                   FontAttributes="Bold"
                                   IsVisible="{Binding IsCancelled}" />

                            <HorizontalStackLayout Spacing="10">
                                <Button
                                    Text="View Details"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding BindingContext.OpenEventCommand, Source={x:Reference RootPage}}"
                                    CommandParameter="{Binding .}" />

                                <Button
                                    Text="Cancel Event"
                                    Style="{StaticResource PrimaryButton}"
                                    IsVisible="{Binding BindingContext.IsAdmin, Source={x:Reference RootPage}}"
                                    Command="{Binding BindingContext.CancelEventCommand, Source={x:Reference RootPage}}"
                                    CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>
