<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CampusPulse.Views.FeedPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource LightGray}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- Header -->
        <Grid BackgroundColor="{StaticResource PrimaryColor}" Padding="20">
            <Label Text="Campus Feed" Style="{StaticResource TitleLabel}" />
        </Grid>

        <!-- Category Filter - US-10 -->
        <Grid Padding="20,10" Grid.Row="1">
            <Picker Title="All Categories"
                    ItemsSource="{Binding Categories}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding SelectedCategory}"
                    IsEnabled="{Binding ShowFollowingOnly, Converter={StaticResource InvertedBoolConverter}}" />
        </Grid>

        <!-- Following filter - change request: view content relevant to
             followed interests, right in the campus feed. -->
        <Grid Padding="20,0" Grid.Row="2" ColumnDefinitions="*,Auto">
            <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                <Switch IsToggled="{Binding ShowFollowingOnly}" />
                <Label Text="Following only" VerticalOptions="Center" Style="{StaticResource BodyLabel}" />
            </HorizontalStackLayout>

            <Button Grid.Column="1"
                    Text="My Interests"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding ManageInterestsCommand}" />
        </Grid>

        <!-- Create Post Button -->
        <Grid Padding="20,10,20,10" Grid.Row="3">
            <Button
                Text="Create Post"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding CreatePostCommand}" />
        </Grid>

        <!-- Feed -->
        <CollectionView
            Grid.Row="4"
            ItemsSource="{Binding Posts}"
            SelectionMode="None"
            Margin="20">

            <CollectionView.EmptyView>
                <Label Text="No posts here yet."
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{StaticResource SecondaryColor}" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="10">

                            <Image Source="{Binding ImageBase64, Converter={StaticResource ImageConverter}}"
                                   Aspect="AspectFill"
                                   HeightRequest="160"
                                   IsVisible="{Binding ImageBase64, Converter={StaticResource HasImageConverter}}" />

                            <Label Text="{Binding Title}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource SecondaryColor}" />

                            <Label Text="{Binding Content}"
                                   Style="{StaticResource BodyLabel}" />

                            <Button
                                Text="View Post"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding BindingContext.OpenPostCommand, Source={x:Reference RootPage}}"
                                CommandParameter="{Binding .}" />

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>
