<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="CampusPulse.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Login">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="20"
            VerticalOptions="Center">

            <Label
                Text="CampusPulse"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Student Login"
                FontSize="20"
                HorizontalOptions="Center" />

            <Entry
                Placeholder="Email"
                Keyboard="Email"
                Text="{Binding Email}" />

            <Entry
                Placeholder="Password"
                IsPassword="True"
                Text="{Binding Password}" />

            <Button
                Text="Login"
                Command="{Binding LoginCommand}" />

            <Label
                Text="Test account: student@campuspulse.nz"
                FontSize="12"
                TextColor="Gray"
                HorizontalOptions="Center" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>