<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CampusPulse.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:CampusPulse.ViewModels"
    BackgroundColor="{StaticResource LightGray}">

    <Grid RowDefinitions="Auto,*">

        <!-- ========================= -->
        <!--        CUSTOM HEADER      -->
        <!-- ========================= -->
        <Grid BackgroundColor="{StaticResource PrimaryColor}" Padding="20">
            <Label Text="Welcome Back" Style="{StaticResource TitleLabel}" />
        </Grid>

        <!-- ========================= -->
        <!--        MAIN CONTENT       -->
        <!-- ========================= -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Email -->
                <Frame Style="{StaticResource Card}" Padding="0" CornerRadius="10">
                    <Entry
                        Placeholder="Email"
                        Text="{Binding Email}"
                        Style="{StaticResource InputField}" />
                </Frame>

                <!-- Password -->
                <Frame Style="{StaticResource Card}" Padding="0" CornerRadius="10">
                    <Entry
                        Placeholder="Password"
                        IsPassword="True"
                        Text="{Binding Password}"
                        Style="{StaticResource InputField}" />
                </Frame>

                <!-- Login Button -->
                <Button
                    Text="Login"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    Command="{Binding LoginCommand}" />

                <!-- Shows while waiting on the server - without this, a
                     slow/unreachable connection just looks like the button
                     did nothing at all. -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                    IsVisible="{Binding IsBusy}"
                                    Color="{StaticResource PrimaryColor}" />

                <!-- Register Link -->
                <Label
                    Text="Don't have an account? Register"
                    TextColor="{StaticResource PrimaryColor}"
                    HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
                    </Label.GestureRecognizers>
                </Label>


            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
