<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CampusPulse.Views.MyPostsPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource LightGray}">

    <Grid RowDefinitions="Auto,*">

        <Grid BackgroundColor="{StaticResource PrimaryColor}" Padding="20">
            <Label Text="My Posts" Style="{StaticResource TitleLabel}" />
        </Grid>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Posts}"
            SelectionMode="None"
            Margin="20">

            <CollectionView.EmptyView>
                <Label Text="You haven't posted anything yet."
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{StaticResource SecondaryColor}" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="10">

                            <Label Text="{Binding Title}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource SecondaryColor}" />

                            <Label Text="{Binding Content}"
                                   Style="{StaticResource BodyLabel}" />

                            <HorizontalStackLayout Spacing="10">
                                <Button
                                    Text="View Post"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding BindingContext.OpenPostCommand, Source={x:Reference RootPage}}"
                                    CommandParameter="{Binding .}" />

                                <Button
                                    Text="Delete"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding BindingContext.DeletePostCommand, Source={x:Reference RootPage}}"
                                    CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>
