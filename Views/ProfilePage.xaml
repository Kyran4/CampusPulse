<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CampusPulse.Views.ProfilePage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource LightGray}">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Grid BackgroundColor="{StaticResource PrimaryColor}" Padding="20">
            <Label Text="My Profile" Style="{StaticResource TitleLabel}" />
        </Grid>

        <!-- CONTENT -->
        <VerticalStackLayout Grid.Row="1" Padding="20" Spacing="20">

            <Frame Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding DisplayName}"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource SecondaryColor}" />

                    <Label Text="{Binding Email}"
                           Style="{StaticResource BodyLabel}" />
                </VerticalStackLayout>
            </Frame>

            <Button Text="Logout"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding BindingContext.LogoutCommand, Source={x:Reference RootPage}}" />

        </VerticalStackLayout>

    </Grid>
</ContentPage>
