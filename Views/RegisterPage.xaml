<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CampusPulse.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:CampusPulse.ViewModels"
    BackgroundColor="{StaticResource LightGray}">

    <Grid RowDefinitions="Auto,*">

        <!-- ========================= -->
        <!--        CUSTOM HEADER      -->
        <!-- ========================= -->
        <Grid BackgroundColor="{StaticResource PrimaryColor}" Padding="20">
            <Label Text="Create Account" Style="{StaticResource TitleLabel}" />
        </Grid>

        <!-- ========================= -->
        <!--        MAIN CONTENT       -->
        <!-- ========================= -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Display Name -->
                <Frame Style="{StaticResource Card}" Padding="0" CornerRadius="10">
                    <Entry
                        Placeholder="Display Name"
                        Text="{Binding DisplayName}"
                        Style="{StaticResource InputField}" />
                </Frame>

                <!-- Email -->
                <Frame Style="{StaticResource Card}" Padding="0" CornerRadius="10">
                    <Entry
                        Placeholder="Email"
                        Text="{Binding Email}"
                        Style="{StaticResource InputField}" />
                </Frame>

                <!-- Password -->
                <Frame Style="{StaticResource Card}" Padding="0" CornerRadius="10">
                    <Entry
                        Placeholder="Password"
                        IsPassword="True"
                        Text="{Binding Password}"
                        Style="{StaticResource InputField}" />
                </Frame>

                <!-- Register Button -->
                <Button
                    Text="Register"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    Command="{Binding RegisterCommand}" />

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                    IsVisible="{Binding IsBusy}"
                                    Color="{StaticResource PrimaryColor}" />

                <!-- Login Link -->
                <Label
                    Text="Already have an account? Login"
                    TextColor="{StaticResource PrimaryColor}"
                    HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToLoginCommand}" />
                    </Label.GestureRecognizers>
                </Label>


            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
